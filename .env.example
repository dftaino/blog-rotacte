# Banco (na VPS: o Postgres compartilhado da rede funilads_default)
DB_HOST=db
DB_PORT=5432
DB_NAME=rotacte_blog
DB_USER=rotacte_blog
DB_PASSWORD=troque-aqui

# Senha do /admin — minimo 12 caracteres; com menos que isso o admin NEM ABRE.
ADMIN_SENHA=

# Token que o painel (Orbys) usa para ler metricas e leads — minimo 24 caracteres.
PLATAFORMA_TOKEN=

# Endereco publico (usado no canonical, RSS e sitemap)
SITE_URL=https://blog.rotacte.com.br
