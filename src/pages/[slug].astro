---
import Base from '../layouts/Base.astro'
import { q } from '../lib/db.js'
import { render } from '../lib/markdown.js'
import { nomeDaCategoria } from '../lib/categorias.js'
import { dataBr } from '../lib/datas.js'

const { slug } = Astro.params
const { rows } = await q(
  `select * from post where slug = $1 and status = 'PUBLICADO'`, [slug],
)
if (rows.length === 0) return new Response(null, { status: 404 })
const post = rows[0]
const html = render(post.conteudo_md)
const publicadoEm = dataBr(post.publicado_em)
const categoria = post.categoria ? { slug: post.categoria, nome: nomeDaCategoria(post.categoria) } : null
const { rows: materiais } = await q(`select slug, titulo, descricao from material where ativo order by id limit 2`)
// "Leia tambem" do mesmo assunto: mantem o leitor no blog em vez de devolve-lo
// para a busca do Google.
const { rows: relacionados } = categoria
  ? await q(
      `select slug, titulo from post
       where status = 'PUBLICADO' and categoria = $1 and id <> $2
       order by publicado_em desc limit 3`,
      [post.categoria, post.id],
    )
  : { rows: [] }
---
<Base titulo={post.titulo} descricao={post.resumo} caminho={`/${post.slug}`} tipo="article" imagem={post.capa}>
  <article>
    <div class="linha-meta-post">
      {categoria?.nome && <a class="etiqueta-post" href={`/categoria/${categoria.slug}`}>{categoria.nome}</a>}
      <span class="rotulo-data">{publicadoEm}</span>
    </div>
    <h1>{post.titulo}</h1>
    {post.capa && (
      <img class="capa-post" src={`/capa/${post.capa}`} alt={post.capa_alt || post.titulo}
        width="1200" height="630" />
    )}
    <div class="corpo-post" set:html={html} />
  </article>

  {relacionados.length > 0 && (
    <aside style="margin-top:34px">
      <h2 style="font-size:19px;margin:0 0 10px">Mais sobre {categoria.nome}</h2>
      <ul style="margin:0;padding-left:20px">
        {relacionados.map((r) => (<li style="margin:6px 0"><a href={`/${r.slug}`}>{r.titulo}</a></li>))}
      </ul>
    </aside>
  )}

  {materiais.length > 0 && (
    <aside class="cartao" style="margin-top:38px;border-left:4px solid var(--marca)">
      <strong>Material gratuito</strong>
      <p style="margin:6px 0 10px;color:var(--suave)">{materiais[0].descricao}</p>
      <a class="botao" href={`/materiais/${materiais[0].slug}`}>Baixar: {materiais[0].titulo}</a>
    </aside>
  )}

  <style is:global>
    .linha-meta-post { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
    .etiqueta-post { background: var(--neutro); border: 1px solid var(--linha-forte); color: var(--espresso);
      font-size: 12px; font-weight: 700; padding: 2px 10px; border-radius: 999px; text-decoration: none; }
    .etiqueta-post:hover { background: #ece3cf; }
    .capa-post { width: 100%; height: auto; display: block; border-radius: 14px;
      border: 1px solid var(--linha); margin: 18px 0 26px; }
    .corpo-post { font-size: 17px; max-width: 68ch; }
    .corpo-post h2 { margin-top: 34px; }
    .corpo-post img { max-width: 100%; border-radius: 10px; border: 1px solid var(--linha); }
    .corpo-post blockquote { border-left: 4px solid var(--marca-clara); margin: 18px 0; padding: 4px 18px; color: var(--suave); }
    .corpo-post code { background: var(--neutro); border-radius: 4px; padding: 1px 6px; font-size: .9em; }
    .corpo-post table { border-collapse: collapse; width: 100%; font-size: 15px; margin: 18px 0; display: block; overflow-x: auto; }
    .corpo-post th { text-align: left; background: var(--neutro); padding: 8px 10px; border: 1px solid var(--linha); }
    .corpo-post td { padding: 8px 10px; border: 1px solid var(--linha); vertical-align: top; }
    .corpo-post li { margin: 6px 0; }
  </style>
</Base>
