---
import Base from '../../layouts/Base.astro'
import { q } from '../../lib/db.js'
import { categoriaPorSlug } from '../../lib/categorias.js'
import ListaDePosts from '../../componentes/ListaDePosts.astro'

const { slug } = Astro.params
const categoria = categoriaPorSlug(slug)
if (!categoria) return new Response(null, { status: 404 })

const { rows: posts } = await q(
  `select slug, titulo, resumo, publicado_em, capa, capa_alt, categoria from post
   where status = 'PUBLICADO' and categoria = $1 order by publicado_em desc limit 50`,
  [slug],
)
---
<Base titulo={categoria.nome}
      descricao={`Artigos sobre ${categoria.nome} para transportadoras: o que muda, o que trava a emissão e como resolver.`}
      caminho={`/categoria/${categoria.slug}`}>
  <h1>{categoria.nome}</h1>
  <p style="color:var(--suave)">
    {posts.length === 0
      ? 'Ainda não publicamos nada neste assunto — em breve.'
      : `${posts.length} ${posts.length === 1 ? 'artigo' : 'artigos'} sobre ${categoria.nome}.`}
  </p>
  <ListaDePosts posts={posts} />
</Base>
