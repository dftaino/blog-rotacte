---
import Base from '../layouts/Base.astro'
import { q } from '../lib/db.js'
import ListaDePosts from '../componentes/ListaDePosts.astro'

const { rows: posts } = await q(
  `select slug, titulo, resumo, publicado_em, capa, capa_alt, categoria from post
   where status = 'PUBLICADO' order by publicado_em desc limit 30`,
)
---
<Base titulo="" caminho="/"
      heroTitulo="Documento fiscal e frota, explicados sem juridiquês"
      heroTexto="CT-e, MDF-e, reforma tributária, CIOT e custo por quilômetro — o que o dono de transportadora precisa saber para não travar a emissão nem perder dinheiro na estrada. Escrito por quem desenvolve o RotaCTe.">
  <ListaDePosts posts={posts}
    vazio="Os primeiros artigos estão a caminho. Enquanto isso, veja os materiais gratuitos." />
</Base>
