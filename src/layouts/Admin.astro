---
/** Casca da area restrita: sem SEO, sem indexacao, menu proprio. */
const { titulo } = Astro.props
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex,nofollow" />
  <title>{titulo} · Admin do blog</title>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600;700&display=swap" />
  <style is:global>
    :root { --espresso:#23201a; --marca:#b8860b; --marca-clara:#d0a63c; --sobre-ouro:#231f19;
      --ouro: linear-gradient(180deg,#d0a63c 0%,#b8860b 55%,#946c08 100%);
      --fundo:#faf8f3; --neutro:#f4efe4; --linha:#e7e0d1; --linha-forte:#d8cfbb; --suave:#7c756a; }
    * { box-sizing: border-box; }
    body { margin:0; font-family:'Open Sans',system-ui,sans-serif; background:var(--fundo); color:#2a2620; }
    .barra { background:var(--espresso); color:#fff; padding:10px 18px; display:flex; gap:18px; align-items:center;
      flex-wrap:wrap; border-bottom:3px solid var(--marca); }
    .barra b { margin-right: 8px; }
    .barra b span { color: var(--marca-clara); }
    .barra a { color:#e6ded0; text-decoration:none; font-size:14px; }
    .barra a:hover { color:#fff; }
    main { max-width: 960px; margin: 0 auto; padding: 26px 18px 60px; }
    h1 { font-size: 24px; color: var(--espresso); }
    .cartao { background:#fff; border:1px solid var(--linha); border-radius:14px; padding:18px 20px; margin-bottom:16px; }
    table { border-collapse: collapse; width: 100%; font-size: 14px; }
    th { text-align:left; font-size:11.5px; text-transform:uppercase; letter-spacing:.06em; color:var(--suave);
      padding:8px 10px; border-bottom:1px solid var(--linha); background:var(--neutro); }
    td { padding:8px 10px; border-bottom:1px solid var(--linha); vertical-align: top; }
    tr:last-child td { border-bottom: none; }
    input, textarea, select { width:100%; padding:9px 11px; border:1px solid var(--linha-forte); border-radius:8px;
      font:400 14.5px 'Open Sans',sans-serif; }
    input:focus, textarea:focus { outline:2px solid var(--marca-clara); outline-offset:1px; border-color:var(--marca); }
    textarea { min-height: 320px; font-family: ui-monospace, monospace; font-size: 13.5px; line-height: 1.5; }
    label { font-weight:600; font-size:13.5px; display:block; margin:12px 0 4px; }
    .botao { background:var(--ouro); color:var(--sobre-ouro); border:0; border-radius:8px; padding:10px 18px;
      font:700 14px 'Open Sans',sans-serif; cursor:pointer; text-decoration:none; display:inline-block; }
    .botao:hover { filter: brightness(1.06); }
    .botao.neutro { background:var(--neutro); color:var(--espresso); border:1px solid var(--linha-forte); }
    .pill { font-size:11px; font-weight:700; border-radius:999px; padding:2px 9px; }
    .pill.pub { background:#E3F1E8; color:#276b45; }
    .pill.rasc { background:#f7edd6; color:#8a6008; }
    .num { font-variant-numeric: tabular-nums; text-align: right; }
    .grade-kpi { display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:12px; margin-bottom:18px; }
    .kpi { background:#fff; border:1px solid var(--linha); border-radius:14px; padding:12px 15px; }
    .kpi .v { font-size:24px; font-weight:700; color:var(--espresso); }
    .kpi .r { font-size:12px; color:var(--suave); }
    .rolagem { overflow-x: auto; }
  </style>
</head>
<body>
  <div class="barra">
    <b>RotaCTe <span>· admin do blog</span></b>
    <a href="/admin">Metricas</a>
    <a href="/admin/posts">Posts</a>
    <a href="/admin/leads">Leads</a>
    <a href="/admin/materiais">Materiais</a>
    <a href="/" target="_blank" rel="noopener">Ver o blog ↗</a>
    <a href="/admin/sair" style="margin-left:auto">Sair</a>
  </div>
  <main><slot /></main>
</body>
</html>
